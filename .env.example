# ===== 数据库配置 (MySQL) =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=diabetes

# ===== LLM 配置（OpenAI 兼容协议，可对接 DeepSeek / 通义千问 / OpenAI 等）=====
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ===== 血糖预警阈值 (mmol/L) =====
BG_LOW_THRESHOLD=3.9
BG_HIGH_THRESHOLD=10.0

# ===== 向量数据库 (ChromaDB) =====
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=medical_knowledge
RAG_TOP_K=5

# ===== 可选 =====
# 国内网络无法直连 huggingface.co 时，代码已默认走镜像 https://hf-mirror.com
# 如需自定义，取消下面注释并填写：
# HF_ENDPOINT=https://hf-mirror.com
